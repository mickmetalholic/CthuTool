{
  "name": "@cthutool/agent-runtime",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:deps": "pnpm --filter @cthutool/agent-bridge-protocol build && pnpm --filter @cthutool/agent-protocol build && pnpm --filter @cthutool/browser-runtime-protocol build",
    "build": "pnpm run build:deps && tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke:lna": "pnpm run build && node scripts/lna-compatibility-spike.cjs",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@cthutool/agent-bridge-protocol": "workspace:*",
    "@cthutool/agent-protocol": "workspace:*",
    "@cthutool/browser-runtime-protocol": "workspace:*",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "5.9.2",
    "vitest": "^2.1.9"
  }
}
