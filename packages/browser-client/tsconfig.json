{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "coverage",
    "dist",
    "out",
    "build",
    "release",
    "**/*.spec.ts",
    "tests"
  ]
}
