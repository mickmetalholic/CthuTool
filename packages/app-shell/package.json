{
  "name": "@cthutool/app-shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build:deps": "pnpm --filter @cthutool/ui build",
    "build": "pnpm run build:deps && tsc -p tsconfig.json",
    "test": "pnpm run build:deps && vitest run",
    "test:cov": "pnpm run build:deps && vitest run --coverage",
    "typecheck": "pnpm run build:deps && tsc -p tsconfig.test.json --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@cthutool/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^2.1.9",
    "react": "^19.2.7",
    "typescript": "5.9.2",
    "vitest": "^2.1.9"
  }
}
