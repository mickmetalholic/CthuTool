{
  "name": "@cthutool/app-shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json --noEmit",
    "test:cov": "node -e \"console.log('No coverage configured for @cthutool/app-shell')\"",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@cthutool/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "5.9.2"
  }
}
