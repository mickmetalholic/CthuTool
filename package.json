{
  "name": "cthutool",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "chc": "apps/cli/bin/chc.mjs"
  },
  "files": [
    "apps/cli/bin/chc.mjs",
    "apps/cli/dist",
    "apps/cli/package.json",
    "apps/cli/README.md"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "vitest run && turbo run test",
    "test:cov": "vitest run --coverage && turbo run test:cov",
    "typecheck": "turbo run typecheck",
    "check:cli-dist": "node scripts/check-cli-dist.mjs",
    "setup:ai-tooling": "node scripts/setup-ai-tooling.mjs",
    "check:ai-tooling": "node scripts/setup-ai-tooling.mjs --check",
    "setup:git-hooks": "node scripts/install-git-hooks.mjs",
    "lint": "turbo run lint",
    "lint:fix": "biome check --write .",
    "precommit:cli-dist": "node scripts/precommit-refresh-cli-dist.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "prepack": "pnpm --filter @cthutool/cli build",
    "commit": "git-cz"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "lint-staged": {
    "apps/**/*.{js,ts,mjs,cjs,jsx,tsx,json,jsonc}": "pnpm exec biome check --write --no-errors-on-unmatched",
    "packages/**/*.{js,ts,mjs,cjs,jsx,tsx,json,jsonc}": "pnpm exec biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@types/node": "^22.13.10",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "lint-staged": "^16.4.0",
    "turbo": "^2.8.20",
    "typescript": "5.9.2",
    "vitest": "^2.1.9",
    "yaml": "^2.7.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "volta": {
    "node": "24.14.1",
    "pnpm": "9.15.4"
  }
}
