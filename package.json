{
  "name": "cthutool",
  "private": true,
  "scripts": {
    "build": "pnpm exec turbo run build",
    "biome:check": "pnpm exec biome check .",
    "biome:write": "pnpm exec biome check --write .",
    "check": "pnpm run biome:check && pnpm exec turbo run check",
    "test": "pnpm exec jest --config jest.config.cjs",
    "prepare": "husky",
    "commit": "git-cz"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "turbo": "^2.8.20",
    "typescript": "5.9.2",
    "yaml": "^2.7.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
