node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Local Git worktrees
.worktrees/

# Vercel
.vercel

# Build Outputs
.astro/
.next/
out/
build
dist
!apps/cli/dist/
!apps/cli/dist/index.js
!apps/desktop/build/
!apps/desktop/build/icon.svg
!apps/desktop/build/icon.png

# Runtime data
data/browser/
data/browser-diagnostics/
data/secrets/browser-auth/
apps/backend/data/
apps/cli/data/
output/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Misc
.DS_Store
*.pem
Thumbs.db
*.tmp
*.swp
.idea/

# Keep documented env samples
!.env.example

# Cursor: ignore local cache, but keep shared Project Rules, authored skills, and non-generated commands.
.cursor/*
.cursor/skills/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/commit/
!.cursor/skills/commit/**
!.cursor/skills/create-pull-request/
!.cursor/skills/create-pull-request/**
!.cursor/commands/
!.cursor/commands/**

# Generated OpenSpec / shared agent skill surfaces (regenerate with pnpm setup:ai-tooling)
.agents/
.opencode/

# Legacy generated OpenSpec copies under agent dirs (do not reintroduce)
.codex/skills/
.claude/skills/

# References codes for agents
.references/

# Reasonix local desktop/session state and optional machine-local settings
.reasonix/

.superpowers
