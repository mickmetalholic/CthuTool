# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Misc
.DS_Store
*.pem
Thumbs.db
*.tmp
*.swp
.idea/

# Keep documented env samples
!.env.example

# Agent adapters: keep shared project instructions, ignore generated Speckit adapters.
# Speckit source of truth lives in .specify/ and specs/.
.claude/commands/speckit*.md
.claude/skills/speckit-*/
.codex/commands/speckit*.md
.codex/skills/speckit-*/

# Cursor: ignore local cache, but keep shared Project Rules and non-generated commands.
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/commands/
!.cursor/commands/**
.cursor/commands/speckit*.md

# References codes for agents
.references/

.superpowers
