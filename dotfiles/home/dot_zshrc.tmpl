{{- $local := dict -}}
{{- if and (hasKey . "local") (kindIs "map" (get . "local")) -}}
{{-   $local = get . "local" -}}
{{- end -}}
{{- $key := get $local "host" -}}
{{- $id := "" -}}
{{- range $name, $h := .hosts -}}
{{-   if eq (lower $name) (lower $key) }}{{ $id = $name }}{{ end -}}
{{- if kindIs "slice" (get $h "aliases") -}}
{{-   range $a := get $h "aliases" -}}
{{-     if eq (lower $a) (lower $key) }}{{ $id = $name }}{{ end -}}
{{-   end -}}
{{- end -}}
{{- end -}}
{{- $k3sSelected := false -}}
{{- if $id -}}
{{-   $h := index .hosts $id -}}
{{-   if kindIs "slice" (get $h "tools") -}}
{{-     $k3sSelected = has "k3s" (get $h "tools") -}}
{{-   end -}}
{{- end -}}
export EDITOR="{{ .defaults.editor }}"
export PATH="$HOME/.local/bin:$PATH"
{{- if $k3sSelected }}

export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
{{- end }}

for completions in \
  /opt/homebrew/share/zsh-completions \
  /usr/local/share/zsh-completions \
  /usr/share/zsh/vendor-completions; do
  if [ -d "$completions" ]; then
    fpath=("$completions" $fpath)
  fi
done

export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_THEME=""
plugins=(git history-substring-search sudo eza fzf)

if [ -r "$ZSH/oh-my-zsh.sh" ]; then
  source "$ZSH/oh-my-zsh.sh"
else
  mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
  autoload -Uz compinit
  compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"

  if command -v fzf >/dev/null 2>&1; then
    eval "$(fzf --zsh 2>/dev/null)"
  fi

  for plugin in \
    /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh \
    /usr/local/share/zsh-history-substring-search/zsh-history-substring-search.zsh \
    /usr/share/zsh-history-substring-search/zsh-history-substring-search.zsh \
    /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh; do
    if [ -r "$plugin" ]; then
      source "$plugin"
      bindkey "$terminfo[kcuu1]" history-substring-search-up
      bindkey "$terminfo[kcud1]" history-substring-search-down
      break
    fi
  done

  sudo-command-line() {
    if [ -z "$BUFFER" ]; then
      zle up-history
    fi
    if [[ "$BUFFER" == sudo\ * ]]; then
      BUFFER="${BUFFER#sudo }"
    else
      BUFFER="sudo $BUFFER"
    fi
    zle end-of-line
  }
  zle -N sudo-command-line
  bindkey '\e\e' sudo-command-line

  if command -v eza >/dev/null 2>&1; then
    alias ls='eza --icons=auto'
    alias ll='eza -lh --icons=auto --git'
    alias la='eza -lah --icons=auto --git'
    alias lt='eza --tree --level=2 --icons=auto'
  fi
fi

eval "$(starship init zsh 2>/dev/null)"
eval "$(zoxide init zsh 2>/dev/null)"
eval "$(mise activate zsh 2>/dev/null)"

if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'

for plugin in \
  /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh; do
  if [ -r "$plugin" ]; then
    source "$plugin"
    break
  fi
done

for plugin in \
  /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
  if [ -r "$plugin" ]; then
    source "$plugin"
    break
  fi
done

{{- $profile := joinPath .chezmoi.destDir ".zshrc" -}}
{{- if stat $profile -}}
{{- $existing := include $profile -}}
{{- range $pattern := list "(?ms)^# >>> cthutool chc completion >>>\\r?\\n.*?^# <<< cthutool chc completion <<<" "(?ms)^# >>> cthutool bootstrap PATH >>>\\r?\\n.*?^# <<< cthutool bootstrap PATH <<<" -}}
{{- $blocks := regexFindAll $pattern $existing -1 -}}
{{- if $blocks }}
{{ index $blocks 0 }}
{{ end -}}
{{- end -}}
{{- end }}
