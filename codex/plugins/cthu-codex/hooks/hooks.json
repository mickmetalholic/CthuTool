{
  "description": "CthuCodex language coaching hook that asks Codex to review English before continuing.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<PLUGIN_ROOT>/scripts/language-coach.mjs\"",
            "timeout": 5,
            "statusMessage": "Preparing language coaching"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<PLUGIN_ROOT>/scripts/obsidian-agents-sync.mjs\" --phase before",
            "timeout": 120,
            "statusMessage": "Preparing Obsidian agents"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<PLUGIN_ROOT>/scripts/obsidian-agents-sync.mjs\" --phase after",
            "timeout": 120,
            "statusMessage": "Publishing Obsidian agents"
          }
        ]
      }
    ]
  }
}
