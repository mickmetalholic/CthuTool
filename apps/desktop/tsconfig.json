{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "paths": {
      "@cthutool/agent-protocol": ["../../packages/agent-protocol/src"],
      "@cthutool/app-shell": ["../../packages/app-shell/src"],
      "@cthutool/ui": ["../../packages/ui/src"],
      "@cthutool/ui/styles.css": ["../../packages/ui/src/styles.css"]
    },
    "types": [
      "node",
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "release"]
}
