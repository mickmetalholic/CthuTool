{
  "name": "@cthutool/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:deps": "pnpm --filter @cthutool/agent-protocol build && pnpm --filter @cthutool/config build",
    "dev": "pnpm run build:deps && nest start --watch",
    "start": "pnpm run build:deps && nest start",
    "start:debug": "pnpm run build:deps && nest start --debug --watch",
    "start:prod": "nest start --prod",
    "build": "pnpm run build:deps && nest build",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run src",
    "test:e2e": "vitest run e2e",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@cthutool/agent-protocol": "workspace:*",
    "@cthutool/config": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "neverthrow": "^8.2.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "valibot": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.15.41",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.1.9",
    "supertest": "^7.0.0",
    "typescript": "5.9.2",
    "vitest": "^2.1.9"
  }
}
