{
  "name": "@cthutool/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:deps": "pnpm --filter @cthutool/agent-protocol build && pnpm --filter @cthutool/config build",
    "dev": "pnpm run build:deps && nest start --watch",
    "start": "pnpm run build:deps && nest start",
    "start:debug": "pnpm run build:deps && nest start --debug --watch",
    "start:prod": "nest start --prod",
    "build": "pnpm run build:deps && nest build",
    "test": "pnpm run build:deps && jest",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk node_modules/jest/bin/jest.js --runInBand",
    "test:cov": "pnpm run build:deps && jest --coverage"
  },
  "dependencies": {
    "@cthutool/agent-protocol": "workspace:*",
    "@cthutool/config": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "neverthrow": "^8.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "valibot": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "typescript": "5.9.2"
  }
}
