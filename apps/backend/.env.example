# Service configuration (see src/config/service-configuration.ts).
# Copy to .env and load into the environment, or export vars in your shell.
# This app does not load .env files by default; Nest reads process.env only.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

BROWSER_PROVIDER=local-playwright
BROWSER_HEADLESS=true
BROWSER_DATA_DIR=./data/browser
BROWSER_AUTH_STATE_DIR=./data/secrets/browser-auth
BROWSER_DIAGNOSTICS_DIR=./data/browser-diagnostics
BROWSER_MAX_CONCURRENCY=1
BROWSER_DEFAULT_TIMEOUT_MS=30000
BROWSER_DEFAULT_DELAY_MS=1000
