{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "esModuleInterop": true,
    "types": ["node"],
    "declaration": false,
    "outDir": "./dist/apps/backend"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "coverage",
    "dist",
    "out",
    "build",
    "release",
    "e2e/**/*",
    "**/*.spec.ts"
  ]
}
