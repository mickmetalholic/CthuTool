{
  "name": "@cthutool/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "node ../../scripts/build-workspace-dependencies.mjs @cthutool/agent-data-migration @cthutool/agent-release",
    "dev": "bun build src/index.ts --outdir dist --target node --watch",
    "build": "pnpm run build:deps && node ../../scripts/build-cli-dist.mjs",
    "test": "pnpm run build:deps && pnpm run test:unit && pnpm run test:integration",
    "test:unit": "pnpm run build:deps && ../../scripts/run-bun.sh test --timeout 30000 --preload ./tests/setup.ts tests/unit src/tests/scripts/convert-to-cbz/unit",
    "test:integration": "pnpm run build:deps && ../../scripts/run-bun.sh test --timeout 30000 --preload ./tests/setup.ts tests/integration src/tests/scripts/convert-to-cbz/integration",
    "test:cov": "pnpm run build:deps && ../../scripts/run-bun.sh test --timeout 30000 --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-dir=coverage --preload ./tests/setup.ts && node ./tools/filter-coverage-lcov.mjs",
    "typecheck": "pnpm run build:deps && ../../scripts/run-bun.sh x tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@cthutool/agent-data-migration": "workspace:*",
    "@cthutool/agent-release": "workspace:*",
    "@clack/prompts": "^0.8.2",
    "archiver": "^7.0.1",
    "citty": "^0.1.6",
    "cli-progress": "^3.12.0",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.2",
    "neverthrow": "^8.2.0",
    "p-limit": "^7.3.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.60.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/cli-progress": "^3.11.6",
    "bun-types": "^1.3.11"
  }
}
