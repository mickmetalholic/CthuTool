{
  "name": "@cthutool/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "node dist/index.js",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test --preload ./tests/setup.ts",
    "test:cov": "bun test --coverage --preload ./tests/setup.ts",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "archiver": "^7.0.1",
    "boxen": "^8.0.1",
    "citty": "^0.1.6",
    "cli-progress": "^3.12.0",
    "fflate": "^0.8.2",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "neverthrow": "^8.2.0",
    "p-limit": "^7.3.0",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/react": "^18.3.24",
    "bun-types": "^1.3.11"
  }
}
