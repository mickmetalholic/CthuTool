func TestSetupHostUnsupportedPlatformFailsBeforeDispatch(t *testing.T) {
	root := t.TempDir()
	writeManagedToolData(t, root)
	runner := &fakeRunner{outputs: map[string][]byte{
		"lookpath apt-get": []byte(""),
		"lookpath winget":  []byte(""),
	}}
	var out strings.Builder
	code := Execute([]string{"setup", "--dry-run"}, Options{
		Root:   root,
		OS:     "windows",
		Env:    withHost([]string{"PATH=/bin"}, "linux-wsl"),
		Runner: runner,
		Stdout: &out,
		Stderr: &strings.Builder{},
	})
	if code == 0 {
		t.Fatalf("expected OS mismatch to stop setup\n%s", out.String())
	}
	if !strings.Contains(out.String(), "host resolution") {
		t.Fatalf("setup output missing host resolution failure:\n%s", out.String())
	}
	for _, command := range runner.commands {
		if command.name == "winget" || command.name == "sudo" {
			t.Fatalf("OS mismatch must not dispatch installers: %#v", runner.commands)
		}
	}
}
