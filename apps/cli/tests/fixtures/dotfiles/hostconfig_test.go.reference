func TestLoadHostConfigLoadsCanonicalDefaults(t *testing.T) {
	root := t.TempDir()
	writeManagedToolData(t, root)
	config, err := loadHostConfig(root)
	if err != nil {
		t.Fatal(err)
	}
	if config.Defaults.Name != "Test User" || config.Defaults.Email != "test@example.com" || config.Defaults.Editor != "nvim" {
		t.Fatalf("defaults = %#v", config.Defaults)
	}
	if config.Defaults.SSHAgent != "system" || config.Defaults.Repo != "git@github.com:mickmetalholic/dotfiles.git" {
		t.Fatalf("defaults = %#v", config.Defaults)
	}
	if config.Platforms["windows"].Shell != "pwsh" || config.Platforms["linux"].Terminal != "wezterm" {
		t.Fatalf("platforms = %#v", config.Platforms)
	}
	if len(config.Hosts) != 5 || config.Hosts["windows-desktop"].OS != "windows" {
		t.Fatalf("hosts = %#v", config.Hosts)
	}
	if !contains(config.Hosts["windows-desktop"].Aliases, "SARGERAS") {
		t.Fatalf("windows-desktop aliases = %#v", config.Hosts["windows-desktop"].Aliases)
	}
}

func TestLoadHostConfigMissingDefaultsRejects(t *testing.T) {
	root := t.TempDir()
	if err := os.MkdirAll(filepath.Join(root, "home", ".chezmoidata"), 0755); err != nil {
		t.Fatal(err)
	}
	if _, err := loadHostConfig(root); err == nil || !strings.Contains(err.Error(), "canonical defaults") {
		t.Fatalf("expected missing defaults error, got %v", err)
	}
}

func TestLoadHostConfigRejectsMalformedYAML(t *testing.T) {
	root := t.TempDir()
	writeManagedToolData(t, root)
	if err := os.WriteFile(filepath.Join(root, "home", ".chezmoidata", "hosts.yaml"), []byte("hosts:\n  windows-desktop: [unclosed\n"), 0644); err != nil {
		t.Fatal(err)
	}
	if _, err := loadHostConfig(root); err == nil || !strings.Contains(err.Error(), "decode canonical hosts") {
		t.Fatalf("expected decode error, got %v", err)
	}
}

func TestLoadHostConfigRejectsUnknownFields(t *testing.T) {
	root := t.TempDir()
	writeManagedToolData(t, root)
	if err := os.WriteFile(filepath.Join(root, "home", ".chezmoidata", "hosts.yaml"), []byte("hosts:\n  windows-desktop:\n    os: windows\n    mysteryField: true\n"), 0644); err != nil {
		t.Fatal(err)
	}
	if _, err := loadHostConfig(root); err == nil || !strings.Contains(err.Error(), "field mysteryField not found") {
		t.Fatalf("expected unknown field error, got %v", err)
	}
}

func TestResolveHostByCanonicalIDCaseInsensitive(t *testing.T) {
	config := &hostConfig{Hosts: map[string]canonicalHost{
		"windows-desktop": {OS: "windows", Toolsets: []string{"core"}},
	}}
	for _, requested := range []string{"windows-desktop", "WINDOWS-DESKTOP", "Windows-Desktop"} {
		host, err := config.resolveHost(requested, identitySourceEnv, "windows")
		if err != nil {
			t.Fatalf("%s: %v", requested, err)
		}
		if !host.Declared || host.ID != "windows-desktop" || host.Requested != requested {
			t.Fatalf("%s resolved to %#v", requested, host)
		}
	}
}

func TestResolveHostByAliasCaseInsensitive(t *testing.T) {
	config := &hostConfig{Hosts: map[string]canonicalHost{
		"windows-desktop": {OS: "windows", Aliases: []string{"SARGERAS"}},
	}}
	for _, requested := range []string{"SARGERAS", "sargeras", "Sargeras"} {
		host, err := config.resolveHost(requested, identitySourceHostname, "windows")
		if err != nil {
			t.Fatalf("%s: %v", requested, err)
		}
		if !host.Declared || host.ID != "windows-desktop" {
			t.Fatalf("%s resolved to %#v", requested, host)
		}
	}
}

func TestWSLIdentityIsExplicitAndWindowsAliasReserved(t *testing.T) {
	root := repoRootDir(t)
	config, err := loadHostConfig(root)
	if err != nil {
		t.Fatal(err)
	}
	wsl, err := config.resolveHost("MARDUM", identitySourceEnv, "linux")
	if err != nil {
		t.Fatal(err)
	}
	if !wsl.Declared || wsl.ID != "linux-wsl" || wsl.OS != "linux" {
		t.Fatalf("MARDUM resolved to %#v", wsl)
	}
	if _, err := config.resolveHost("SARGERAS", identitySourceHostname, "linux"); err == nil || !strings.Contains(err.Error(), "host windows-desktop is declared for windows") {
		t.Fatalf("SARGERAS must remain reserved for Windows, got %v", err)
	}
}

func TestStandardizedDeviceAliasesResolveToCanonicalHosts(t *testing.T) {
	root := repoRootDir(t)
	config, err := loadHostConfig(root)
	if err != nil {
		t.Fatal(err)
	}
	for _, tc := range []struct {
		alias     string
		canonical string
		runtimeOS string
	}{
		{alias: "SARGERAS", canonical: "windows-desktop", runtimeOS: "windows"},
		{alias: "NYARLATHOTEP", canonical: "darwin-macbook-pro", runtimeOS: "darwin"},
		{alias: "NZOTH", canonical: "darwin-mac-mini", runtimeOS: "darwin"},
		{alias: "MARDUM", canonical: "linux-wsl", runtimeOS: "linux"},
		{alias: "CTHULHU", canonical: "linux-ubuntu-server", runtimeOS: "linux"},
	} {
		host, err := config.resolveHost(tc.alias, identitySourceEnv, tc.runtimeOS)
		if err != nil {
			t.Fatalf("%s: %v", tc.alias, err)
		}
		if host.ID != tc.canonical {
			t.Fatalf("%s resolved to %s, want %s", tc.alias, host.ID, tc.canonical)
		}
	}
}

func TestRemovedPlaceholderHostsAreUndeclared(t *testing.T) {
	root := repoRootDir(t)
	config, err := loadHostConfig(root)
	if err != nil {
		t.Fatal(err)
	}
	for _, id := range []string{"work-mac", "linux-devbox"} {
		host, err := config.resolveHost(id, identitySourceEnv, "linux")
		if err != nil {
			t.Fatalf("%s: %v", id, err)
		}
		if host.Declared {
			t.Fatalf("removed host %s still resolved to %#v", id, host)
		}
	}
}

func TestResolveHostMergesPlatformDefaults(t *testing.T) {
	config := &hostConfig{
		Platforms: map[string]platformDefaults{
			"darwin": {Shell: "zsh", Terminal: "ghostty"},
		},
		Hosts: map[string]canonicalHost{
			"darwin-macbook-pro": {OS: "darwin"},
		},
	}
	host, err := config.resolveHost("darwin-macbook-pro", identitySourceEnv, "darwin")
	if err != nil {
		t.Fatal(err)
	}
	if host.Shell != "zsh" || host.Terminal != "ghostty" {
		t.Fatalf("platform defaults not inherited: %#v", host)
	}
}

func TestResolveHostOverridesPlatformDefaults(t *testing.T) {
	config := &hostConfig{
		Platforms: map[string]platformDefaults{
			"windows": {Shell: "powershell", Terminal: "windows-terminal"},
		},
		Hosts: map[string]canonicalHost{
			"windows-desktop": {OS: "windows", Shell: "pwsh"},
		},
	}
	host, err := config.resolveHost("windows-desktop", identitySourceEnv, "windows")
	if err != nil {
		t.Fatal(err)
	}
	if host.Shell != "pwsh" {
		t.Fatalf("host override lost: %#v", host)
	}
	if host.Terminal != "windows-terminal" {
		t.Fatalf("platform default lost: %#v", host)
	}
}

func TestResolveHostUndeclaredIdentity(t *testing.T) {
	config := &hostConfig{Hosts: map[string]canonicalHost{
		"windows-desktop": {OS: "windows"},
	}}
	host, err := config.resolveHost("mystery-box", identitySourceHostname, "linux")
	if err != nil {
		t.Fatal(err)
	}
	if host.Declared || host.ID != "" || host.Requested != "mystery-box" {
		t.Fatalf("undeclared host = %#v", host)
	}
}

func TestResolveHostRejectsOSMismatch(t *testing.T) {
	config := &hostConfig{Hosts: map[string]canonicalHost{
		"windows-desktop": {OS: "windows"},
	}}
	_, err := config.resolveHost("windows-desktop", identitySourceEnv, "darwin")
	if err == nil || !strings.Contains(err.Error(), "declared for windows") {
		t.Fatalf("expected OS mismatch error, got %v", err)
	}
}

func TestResolveHostRejectsAmbiguousAlias(t *testing.T) {
	config := &hostConfig{Hosts: map[string]canonicalHost{
		"windows-desktop": {OS: "windows", Aliases: []string{"SARGERAS"}},
		"darwin-mac-mini": {OS: "darwin", Aliases: []string{"sargeras"}},
	}}
	_, err := config.resolveHost("SARGERAS", identitySourceEnv, "windows")
	if err == nil || !strings.Contains(err.Error(), "ambiguously") {
		t.Fatalf("expected ambiguous alias error, got %v", err)
	}
}

func TestResolveHostRejectsDuplicateCaseInsensitiveID(t *testing.T) {
	config := &hostConfig{Hosts: map[string]canonicalHost{
