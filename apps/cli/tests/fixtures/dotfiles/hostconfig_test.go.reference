func TestValidateChezmoiConfigHostFactsRejectsEmbeddedHost(t *testing.T) {
	root := t.TempDir()
	writeManagedToolData(t, root)
	template := `[data.local]
host = "windows-desktop"
`
	if err := os.WriteFile(filepath.Join(root, "home", ".chezmoi.toml.tmpl"), []byte(template), 0644); err != nil {
		t.Fatal(err)
	}
	var out strings.Builder
	rep := newReporter(&out)
	if validateChezmoiConfigHostFacts(root, rep) {
		t.Fatalf("expected embedded host fact rejection:\n%s", out.String())
	}
	if !strings.Contains(out.String(), "windows-desktop") || !strings.Contains(out.String(), "embedded") {
		t.Fatalf("expected embedded host fact message:\n%s", out.String())
	}
}

