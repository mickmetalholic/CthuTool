func TestResolveRequestedIdentityFallsBackToHostname(t *testing.T) {
	prev := osHostname
	osHostname = func() (string, error) { return "sargeras", nil }
	defer func() { osHostname = prev }()
	identity := resolveRequestedIdentity(&fakeRunner{}, []string{"PATH=/bin"})
	if identity.Requested != "sargeras" || identity.Source != identitySourceHostname {
		t.Fatalf("identity = %#v", identity)
	}
}

func TestResolveRequestedIdentityIgnoresInvalidChezmoiData(t *testing.T) {
	prev := osHostname
	osHostname = func() (string, error) { return "sargeras", nil }
	defer func() { osHostname = prev }()
	runner := &fakeRunner{outputs: map[string][]byte{
		"lookpath chezmoi":           []byte(""),
		"chezmoi data --format json": []byte("not-json"),
	}}
	identity := resolveRequestedIdentity(runner, []string{"PATH=/bin"})
	if identity.Source != identitySourceHostname {
		t.Fatalf("identity = %#v", identity)
	}
}

func TestResolveRequestedIdentityUnknownFallback(t *testing.T) {
	prev := osHostname
	osHostname = func() (string, error) { return "", os.ErrNotExist }
	defer func() { osHostname = prev }()
	identity := resolveRequestedIdentity(&fakeRunner{}, []string{"PATH=/bin"})
	if identity.Requested != "unknown" || identity.Source != identitySourceUnknown {
		t.Fatalf("identity = %#v", identity)
	}
}

func TestValidateCanonicalHostConfigAcceptsFixture(t *testing.T) {
	root := t.TempDir()
	writeManagedToolData(t, root)
	var out strings.Builder
	rep := newReporter(&out)
	if !validateCanonicalHostConfig(root, rep) {
		t.Fatalf("canonical host config validation failed:\n%s", out.String())
	}
}

func TestValidateCanonicalHostConfigRejectsDuplicateAlias(t *testing.T) {
	root := t.TempDir()
	writeManagedToolData(t, root)
	hosts := "hosts:\n  windows-desktop:\n    os: windows\n    aliases:\n      - SARGERAS\n  darwin-mac-mini:\n    os: darwin\n    aliases:\n      - sargeras\n"
	if err := os.WriteFile(filepath.Join(root, "home", ".chezmoidata", "hosts.yaml"), []byte(hosts), 0644); err != nil {
		t.Fatal(err)
	}
	var out strings.Builder
	rep := newReporter(&out)
	if validateCanonicalHostConfig(root, rep) {
		t.Fatalf("expected duplicate alias validation failure:\n%s", out.String())
	}
	if !strings.Contains(out.String(), "collides with") {
		t.Fatalf("validation output missing collision detail:\n%s", out.String())
	}
}

func TestValidateCanonicalHostConfigRejectsEmptyIdentities(t *testing.T) {
	for name, hosts := range map[string]string{
		"host id": "hosts:\n  '':\n    os: windows\n    shell: pwsh\n    terminal: windows-terminal\n",
		"alias":   "hosts:\n  windows-desktop:\n    os: windows\n    aliases:\n      - '  '\n",
	} {
		t.Run(name, func(t *testing.T) {
			root := t.TempDir()
			writeManagedToolData(t, root)
			if err := os.WriteFile(filepath.Join(root, "home", ".chezmoidata", "hosts.yaml"), []byte(hosts), 0644); err != nil {
				t.Fatal(err)
			}
			var out strings.Builder
			rep := newReporter(&out)
			if validateCanonicalHostConfig(root, rep) {
				t.Fatalf("expected empty %s validation failure:\n%s", name, out.String())
			}
			if !strings.Contains(out.String(), "empty") {
				t.Fatalf("validation output missing empty identity detail:\n%s", out.String())
			}
		})
	}
}

