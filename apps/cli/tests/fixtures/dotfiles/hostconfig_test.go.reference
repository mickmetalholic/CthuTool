func TestResolveRequestedIdentityPrefersEnvironment(t *testing.T) {
	runner := &fakeRunner{outputs: map[string][]byte{
		"lookpath chezmoi":           []byte(""),
		"chezmoi data --format json": []byte(`{"local":{"host":"persisted-host"},"host":"legacy-host"}`),
	}}
	identity := resolveRequestedIdentity(runner, []string{"PATH=/bin", "DOTFILES_HOST=windows-desktop"})
	if identity.Requested != "windows-desktop" || identity.Source != identitySourceEnv {
		t.Fatalf("identity = %#v", identity)
	}
}

func TestResolveRequestedIdentityLocalOverLegacyAndHostname(t *testing.T) {
	prev := osHostname
	osHostname = func() (string, error) { return "sargeras", nil }
	defer func() { osHostname = prev }()
	runner := &fakeRunner{outputs: map[string][]byte{
		"lookpath chezmoi":           []byte(""),
		"chezmoi data --format json": []byte(`{"local":{"host":"darwin-macbook-pro"},"host":"legacy-host"}`),
	}}
	identity := resolveRequestedIdentity(runner, []string{"PATH=/bin"})
	if identity.Requested != "darwin-macbook-pro" || identity.Source != identitySourceLocal {
		t.Fatalf("identity = %#v", identity)
	}
}

func TestResolveRequestedIdentityLegacyOverHostname(t *testing.T) {
	prev := osHostname
	osHostname = func() (string, error) { return "sargeras", nil }
	defer func() { osHostname = prev }()
	runner := &fakeRunner{outputs: map[string][]byte{
