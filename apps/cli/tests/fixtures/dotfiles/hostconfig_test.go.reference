		t.Fatalf("validation output missing embedded fact detail:\n%s", out.String())
	}
}

func TestChezmoiRenderingIntegrationFixtures(t *testing.T) {
	if _, err := exec.LookPath("chezmoi"); err != nil {
		t.Skip("chezmoi not installed")
	}
	root := repoRootDir(t)
	source := filepath.Join(root, "home")
	config, err := loadHostConfig(root)
	if err != nil {
		t.Fatal(err)
	}
	winDesktop := renderChezmoiIgnoreFixture(t, source, "windows-desktop", "windows")
	for id, host := range config.Hosts {
		shell := host.Shell
		if shell == "" {
			shell = config.Platforms[host.OS].Shell
		}
		terminal := host.Terminal
		if terminal == "" {
			terminal = config.Platforms[host.OS].Terminal
		}
		rendered := renderChezmoiIgnoreFixture(t, source, id, host.OS)
		if mismatches := ignoreMatrixMismatches(ignoreLines(rendered), shell, terminal, host.Toolsets); len(mismatches) > 0 {
			t.Fatalf("host %s: %s\nrendered:\n%s", id, strings.Join(mismatches, "; "), rendered)
		}
	}
	for _, pair := range []struct {
		canonical string
		alias     string
		runtimeOS string
	}{
		{canonical: "windows-desktop", alias: "SARGERAS", runtimeOS: "windows"},
		{canonical: "darwin-macbook-pro", alias: "NYARLATHOTEP", runtimeOS: "darwin"},
		{canonical: "darwin-mac-mini", alias: "NZOTH", runtimeOS: "darwin"},
		{canonical: "linux-wsl", alias: "MARDUM", runtimeOS: "linux"},
		{canonical: "linux-ubuntu-server", alias: "CTHULHU", runtimeOS: "linux"},
		{canonical: "windows-desktop", alias: "win-desktop", runtimeOS: "windows"},
		{canonical: "darwin-macbook-pro", alias: "macbook-pro", runtimeOS: "darwin"},
		{canonical: "linux-ubuntu-server", alias: "cthulhu", runtimeOS: "linux"},
	} {
		canonical := renderChezmoiIgnoreFixture(t, source, pair.canonical, pair.runtimeOS)
		alias := renderChezmoiIgnoreFixture(t, source, pair.alias, pair.runtimeOS)
		if alias != canonical {
			t.Fatalf("%s alias rendered differently from %s:\n%s", pair.alias, pair.canonical, alias)
		}
	}
	legacy := renderChezmoiTemplateFixture(t, source, ".chezmoiignore.tmpl", map[string]any{
		"chezmoi": map[string]any{"os": "windows"},
		"host":    "win-desktop",
	})
	if legacy != winDesktop {
		t.Fatalf("legacy host rendered differently from windows-desktop:\n%s", legacy)
	}
	if selected := undeclaredSelectedFiles(ignoreLines(renderChezmoiIgnoreFixture(t, source, "dot-validate-undeclared", "linux"))); len(selected) > 0 {
		t.Fatalf("undeclared identity selected host-dependent files: %s", strings.Join(selected, ", "))
	}
	if out, err := executeChezmoiTemplateFixture(t, source, ".chezmoiignore.tmpl", map[string]any{
		"chezmoi": map[string]any{"os": "windows"},
		"local":   map[string]any{"host": "linux-wsl"},
	}); err == nil || !strings.Contains(string(out), "declared for linux") || !strings.Contains(string(out), "machine is windows") {
		t.Fatalf("expected OS mismatch error, got %v\n%s", err, out)
	}
}

func TestChezmoiIgnoreEnvironmentOverridesPersistedIdentity(t *testing.T) {
	if _, err := exec.LookPath("chezmoi"); err != nil {
		t.Skip("chezmoi not installed")
	}
	root := repoRootDir(t)
	source := filepath.Join(root, "home")
	want := renderChezmoiIgnoreFixture(t, source, "darwin-macbook-pro", "darwin")
	t.Setenv("DOTFILES_HOST", "macbook-pro")
	rendered := renderChezmoiTemplateFixture(t, source, ".chezmoiignore.tmpl", map[string]any{
		"chezmoi": map[string]any{"os": "darwin"},
		"local":   map[string]any{"host": "windows-desktop"},
	})
	if rendered != want {
		t.Fatalf("DOTFILES_HOST did not override local.host:\n%s", rendered)
	}
}

func TestChezmoiConfigRegenerationPreservesOnlyExplicitEmail(t *testing.T) {
	if _, err := exec.LookPath("chezmoi"); err != nil {
		t.Skip("chezmoi not installed")
	}
	root := repoRootDir(t)
	source := filepath.Join(root, "home")
	rendered := renderChezmoiTemplateFixture(t, source, ".chezmoi.toml.tmpl", map[string]any{
		"chezmoi": map[string]any{"hostname": "SARGERAS", "os": "windows"},
		"local":   map[string]any{"host": "windows-desktop"},
	})
	if !strings.Contains(rendered, `host = "windows-desktop"`) || strings.Contains(rendered, "email =") {
		t.Fatalf("partial local identity rendered incorrectly:\n%s", rendered)
	}
	legacy := renderChezmoiTemplateFixture(t, source, ".chezmoi.toml.tmpl", map[string]any{
		"chezmoi": map[string]any{"hostname": "SARGERAS", "os": "windows"},
		"host":    "windows-desktop",
		"email":   "legacy@example.com",
	})
	if !strings.Contains(legacy, `host = "windows-desktop"`) || !strings.Contains(legacy, `email = "legacy@example.com"`) {
		t.Fatalf("legacy identity was not preserved:\n%s", legacy)
	}
}

func renderChezmoiIgnoreFixture(t *testing.T, source, host, runtimeOS string) string {
	t.Helper()
	return renderChezmoiTemplateFixture(t, source, ".chezmoiignore.tmpl", map[string]any{
		"chezmoi": map[string]any{"os": runtimeOS},
		"local":   map[string]any{"host": host},
	})
}

func renderChezmoiTemplateFixture(t *testing.T, source, template string, overrideData map[string]any) string {
	t.Helper()
	out, err := executeChezmoiTemplateFixture(t, source, template, overrideData)
	if err != nil {
		t.Fatalf("render %s: %v\n%s", template, err, out)
	}
	return string(out)
}

func executeChezmoiTemplateFixture(t *testing.T, source, template string, overrideData map[string]any) ([]byte, error) {
	t.Helper()
	data, err := json.Marshal(overrideData)
	if err != nil {
		t.Fatal(err)
	}
	configPath := filepath.Join(t.TempDir(), "chezmoi.toml")
	if err := os.WriteFile(configPath, nil, 0644); err != nil {
		t.Fatal(err)
	}
	args := []string{"-c", configPath, "--config-format", "toml", "execute-template", "-S", source, "--override-data", string(data), "-f", filepath.Join(source, template)}
	return exec.Command("chezmoi", args...).CombinedOutput()
}

func repoRootDir(t *testing.T) string {
	t.Helper()
	dir, err := os.Getwd()
	if err != nil {
		t.Fatal(err)
	}
	for len(dir) > 1 && !dirExists(dir+"/home/.chezmoidata") {
		dir = parentDir(dir)
	}
	if !dirExists(dir + "/home/.chezmoidata") {
		t.Skip("repository home not found")
	}
	return dir
}

func dirExists(path string) bool {
	info, err := os.Stat(path)
	return err == nil && info.IsDir()
}

func parentDir(path string) string {
	return path[:strings.LastIndex(path, string(os.PathSeparator))]
}

func TestDeclaredHostInventoryFixtures(t *testing.T) {
	root := t.TempDir()
	writeManagedToolData(t, root)
	catalog, err := loadCatalog(root)
	if err != nil {
		t.Fatal(err)
	}
	expectedPackage := map[string]map[string]string{
		"linux-wsl": {
			"git": "apt", "fd": "apt", "bat": "apt",
			"codex-cli": "official", "claude-code": "official",
		},
		"linux-ubuntu-server": {"git": "apt", "fd": "apt", "bat": "apt", "docker-engine": "official", "k3s": "official"},
		"windows-desktop":     {"git": "winget"},
		"darwin-macbook-pro":  {"git": "brew"},
		"darwin-mac-mini":     {"git": "brew"},
	}
	expectedSkipped := map[string][]string{
		"linux-wsl":           {},
		"linux-ubuntu-server": {},
		"windows-desktop":     {"fd", "bat", "codex-cli", "claude-code"},
		"darwin-macbook-pro":  {"fd", "bat", "codex-cli", "claude-code"},
		"darwin-mac-mini":     {"fd", "bat", "codex-cli", "claude-code"},
	}
	expectedRuntime := map[string][]string{
		"linux-wsl":           {"reasonix-cli", "openspec-cli"},
		"windows-desktop":     {"reasonix-cli", "openspec-cli"},
		"darwin-macbook-pro":  {"reasonix-cli", "openspec-cli"},
		"darwin-mac-mini":     {"reasonix-cli", "openspec-cli"},
		"linux-ubuntu-server": {},
	}
	for id, wantPackage := range expectedPackage {
		host := catalog.Hosts[id]
		plan, skipped, err := resolveManagedPlanFromCatalog(catalog, host, host.OS)
		if err != nil {
			t.Fatalf("%s: %v", id, err)
		}
		got := map[string]string{}
		for _, entry := range plan {
			got[entry.Tool.ID] = string(entry.Platform.Install)
		}
		if len(got) != len(wantPackage) {
			t.Fatalf("%s: package plan = %#v, want %#v", id, got, wantPackage)
		}
		for tool, install := range wantPackage {
			if got[tool] != install {
				t.Fatalf("%s: %s plan = %q, want %q", id, tool, got[tool], install)
			}
		}
		var skippedIDs = []string{}
		for _, item := range skipped {
			skippedIDs = append(skippedIDs, item.ID)
		}
		sort.Strings(skippedIDs)
		wantSkipped := append([]string{}, expectedSkipped[id]...)
		sort.Strings(wantSkipped)
		if !reflect.DeepEqual(skippedIDs, wantSkipped) {
			t.Fatalf("%s: skipped = %v, want %v", id, skippedIDs, wantSkipped)
		}
		runtime, err := resolveRuntimePlanFromCatalog(catalog, host, host.OS)
		if err != nil {
			t.Fatalf("%s runtime: %v", id, err)
		}
		var runtimeIDs = []string{}
		for _, entry := range runtime {
			runtimeIDs = append(runtimeIDs, entry.Tool.ID)
		}
		if !reflect.DeepEqual(runtimeIDs, expectedRuntime[id]) {
			t.Fatalf("%s: runtime plan = %v, want %v", id, runtimeIDs, expectedRuntime[id])
		}
	}
}

func TestValidateChezmoiConfigHostFactsMissingTemplate(t *testing.T) {
	root := t.TempDir()
	writeManagedToolData(t, root)
	if err := os.Remove(filepath.Join(root, "home", ".chezmoi.toml.tmpl")); err != nil {
		t.Fatal(err)
	}
	var out strings.Builder
	rep := newReporter(&out)
	if validateChezmoiConfigHostFacts(root, rep) {
		t.Fatalf("expected missing template failure:\n%s", out.String())
	}
	if !strings.Contains(out.String(), "cannot read") {
		t.Fatalf("expected missing template message:\n%s", out.String())
	}
}

func TestValidateChezmoiRenderingPassesMatrix(t *testing.T) {
	root := t.TempDir()
	writeManagedToolData(t, root)
	outputs := map[string][]byte{"lookpath chezmoi": []byte("")}
	addStandardRenderingOutputs(outputs, root)
	addRenderingOutput(outputs, root, "dot-validate-undeclared", []string{
		"dot_zshrc.tmpl", "dot_bashrc.tmpl", "dot_profile.tmpl",
		"Documents/PowerShell/Microsoft.PowerShell_profile.ps1.tmpl",
		"dot_config/ghostty/config.tmpl", "dot_config/wezterm/wezterm.lua.tmpl", "dot_config/zellij/config.kdl",
	})
	runner := &fakeRunner{outputs: outputs}
	var out strings.Builder
	rep := newReporter(&out)
	if !validateChezmoiRendering(root, runner, []string{"PATH=/bin", "DOTFILES_HOST=windows-desktop"}, rep) {
		t.Fatalf("rendering matrix validation failed:\n%s", out.String())
	}
	for _, command := range runner.commands {
		if command.name == "chezmoi" && envValue(command.env, "DOTFILES_HOST") != "" {
			t.Fatalf("synthetic rendering leaked ambient DOTFILES_HOST: %#v", command)
		}
	}
}

func TestValidateChezmoiRenderingRejectsWrongShellSelection(t *testing.T) {
	root := t.TempDir()
	writeManagedToolData(t, root)
	outputs := map[string][]byte{"lookpath chezmoi": []byte("")}
	addStandardRenderingOutputs(outputs, root)
	addRenderingOutput(outputs, root, "windows-desktop", []string{
		"dot_bashrc.tmpl", "dot_profile.tmpl",
		"dot_config/ghostty/config.tmpl", "dot_config/wezterm/wezterm.lua.tmpl", "dot_config/zellij/config.kdl",
	})
	runner := &fakeRunner{outputs: outputs}
	var out strings.Builder
	rep := newReporter(&out)
	if validateChezmoiRendering(root, runner, []string{"PATH=/bin"}, rep) {
		t.Fatalf("expected wrong shell selection rejection:\n%s", out.String())
	}
	if !strings.Contains(out.String(), "dot_zshrc.tmpl should be ignored") {
		t.Fatalf("expected zshrc mismatch message:\n%s", out.String())
	}
}

func TestValidateChezmoiRenderingRejectsUndeclaredBoundary(t *testing.T) {
	root := t.TempDir()
	writeManagedToolData(t, root)
	outputs := map[string][]byte{"lookpath chezmoi": []byte("")}
	addStandardRenderingOutputs(outputs, root)
	addRenderingOutput(outputs, root, "windows-desktop", []string{
		"dot_zshrc.tmpl", "dot_bashrc.tmpl", "dot_profile.tmpl",
		"dot_config/ghostty/config.tmpl", "dot_config/wezterm/wezterm.lua.tmpl", "dot_config/zellij/config.kdl",
	})
	addRenderingOutput(outputs, root, "dot-validate-undeclared", []string{
		"dot_bashrc.tmpl", "dot_profile.tmpl",
		"Documents/PowerShell/Microsoft.PowerShell_profile.ps1.tmpl",
		"dot_config/ghostty/config.tmpl", "dot_config/wezterm/wezterm.lua.tmpl", "dot_config/zellij/config.kdl",
	})
	runner := &fakeRunner{outputs: outputs}
	var out strings.Builder
	rep := newReporter(&out)
	if validateChezmoiRendering(root, runner, []string{"PATH=/bin"}, rep) {
		t.Fatalf("expected undeclared boundary rejection:\n%s", out.String())
	}
	if !strings.Contains(out.String(), "dot_zshrc.tmpl") || !strings.Contains(out.String(), "host-dependent files selected") {
		t.Fatalf("expected undeclared boundary message:\n%s", out.String())
	}
}

func TestValidateChezmoiRenderingSkipsWhenUnavailable(t *testing.T) {
	root := t.TempDir()
	writeManagedToolData(t, root)
	runner := &fakeRunner{}
	var out strings.Builder
	rep := newReporter(&out)
	if !validateChezmoiRendering(root, runner, []string{"PATH=/bin"}, rep) {
		t.Fatalf("rendering should skip when chezmoi is unavailable:\n%s", out.String())
	}
	if !strings.Contains(out.String(), "skipped") {
		t.Fatalf("expected skipped status:\n%s", out.String())
	}
}

func addRenderingOutput(outputs map[string][]byte, root, host string, ignored []string) {
	source := filepath.Join(root, "home")
	runtimeOS := "linux"
	switch host {
	case "windows-desktop":
		runtimeOS = "windows"
	case "darwin-macbook-pro", "darwin-mac-mini":
		runtimeOS = "darwin"
	}
	overrideData, err := json.Marshal(map[string]any{
		"chezmoi": map[string]any{"os": runtimeOS},
		"local":   map[string]any{"host": host},
	})
	if err != nil {
		panic(err)
	}
	args := []string{"execute-template", "-S", source, "--override-data", string(overrideData), "-f", filepath.Join(source, ".chezmoiignore.tmpl")}
	outputs[commandKey("chezmoi", args)] = []byte(renderingOutput(ignored))
}

func addStandardRenderingOutputs(outputs map[string][]byte, root string) {
	addRenderingOutput(outputs, root, "windows-desktop", []string{
		"dot_zshrc.tmpl", "dot_bashrc.tmpl", "dot_profile.tmpl",
		"dot_config/ghostty/config.tmpl", "dot_config/wezterm/wezterm.lua.tmpl", "dot_config/zellij/config.kdl",
	})
	for _, host := range []string{"darwin-macbook-pro", "darwin-mac-mini"} {
		addRenderingOutput(outputs, root, host, []string{
			"dot_bashrc.tmpl", "Documents/PowerShell/Microsoft.PowerShell_profile.ps1.tmpl",
			"dot_config/wezterm/wezterm.lua.tmpl", "dot_config/zellij/config.kdl",
		})
	}
	addRenderingOutput(outputs, root, "linux-wsl", []string{
		"dot_bashrc.tmpl", "Documents/PowerShell/Microsoft.PowerShell_profile.ps1.tmpl",
		"dot_config/ghostty/config.tmpl", "dot_config/wezterm/wezterm.lua.tmpl", "dot_config/zellij/config.kdl",
	})
	addRenderingOutput(outputs, root, "linux-ubuntu-server", []string{
		"dot_zshrc.tmpl", "Documents/PowerShell/Microsoft.PowerShell_profile.ps1.tmpl",
		"dot_config/ghostty/config.tmpl", "dot_config/wezterm/wezterm.lua.tmpl", "dot_config/zellij/config.kdl",
	})
}

func renderingOutput(ignored []string) string {
	files := []string{
		"dot_zshrc.tmpl",
		"dot_bashrc.tmpl",
		"dot_profile.tmpl",
		"Documents/PowerShell/Microsoft.PowerShell_profile.ps1.tmpl",
		"dot_config/ghostty/config.tmpl",
		"dot_config/wezterm/wezterm.lua.tmpl",
		"dot_config/zellij/config.kdl",
	}
	set := map[string]bool{}
	for _, file := range ignored {
		set[file] = true
	}
	var lines []string
	for _, file := range files {
		if set[file] {
			lines = append(lines, file)
		}
	}
	return strings.Join(lines, "\n") + "\n"
}
